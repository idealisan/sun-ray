+// A path change that leaves the status as it was still reaches
+// OnPathChanged: a new adapter or a changed route is a change an app that
+// configures the system proxy has to act on.
+func TestNetworkPathChanges(t *testing.T) {
+	onMain(func() { fb.Online, fb.Metered = true, false })
+	var statuses, paths int
+	offStatus := Network.OnChanged(func(NetworkStatus) { statuses++ })
+	defer offStatus()
+	offPath := Network.OnPathChanged(func() { paths++ })
+	defer offPath()
+	wait.Until(t, "the backend asked to watch the network", func() bool {
+		return onMainValue(func() bool { return fb.WatchingNetwork })
+	})
+
+	// Establish the status the following reports are compared with; the
+	// listener of another test may have left it at anything.
+	onMain(func() { fb.EmitNetwork(platform.NetworkStatus{Online: true}) })
+	statuses, paths = 0, 0
+	onMain(func() {
+		fb.EmitNetwork(platform.NetworkStatus{Online: true})  // same status
+		fb.EmitNetwork(platform.NetworkStatus{Online: false}) // a change
+	})
+	if statuses != 1 {
+		t.Errorf("OnChanged calls = %d, want 1", statuses)
+	}
+	if paths != 2 {
+		t.Errorf("OnPathChanged calls = %d, want 2", paths)
+	}
+}
