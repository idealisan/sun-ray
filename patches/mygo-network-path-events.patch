+// OnPathChanged is called on the main thread whenever the computer's
+// network configuration changes: a route, an interface, a network
+// service. OnChanged only hears about a changed status, and a new adapter
+// or a changed route can leave the machine as online as it was; an app
+// that configures the system proxy needs to hear about that too.
+func (n *NetworkModule) OnPathChanged(fn func()) (off func()) {
+	off = n.onPathChanged.add(fn, false)
+	n.watch()
+	return off
+}
+
+// watch starts the backend's network monitor once.
