diff --git a/internal/darwin/app.go b/internal/darwin/app.go
index 492a024d..a5b74a6b 100644
--- a/internal/darwin/app.go
+++ b/internal/darwin/app.go
@@ -265,8 +265,37 @@ const (
 	kAEQuitApplication = 0x71756974 // 'quit'
 	keyErrorNumber     = 0x6572726E // 'errn'
 	userCanceledErr    = -128
+
+	// kAEQuitReason is the quit event's 'why?' attribute, which the system
+	// sets at a logout, restart or shutdown and leaves out for Cmd+Q, the
+	// Dock's Quit and AppleScript.
+	kAEQuitReason         = 0x7768793F // 'why?'
+	kAELogOut             = 0x6C6F676F // 'logo'
+	kAEReallyLogOut       = 0x726C676F // 'rlgo'
+	kAERestart            = 0x72657374 // 'rest'
+	kAEShutDown           = 0x73687574 // 'shut'
+	kAEShowRestartDialog  = 0x72727374 // 'rrst'
+	kAEShowShutdownDialog = 0x7273646E // 'rsdn'
 )
 
+// quitReasonFromEvent says why a quit was asked for. The system attaches
+// kAEQuitReason to the quit it sends at a logout, restart or shutdown; a
+// quit the user asked for has no reason, and Cmd+Q has no event at all.
+func quitReasonFromEvent(event id) platform.QuitReason {
+	if event == 0 {
+		return platform.QuitReasonUser
+	}
+	why := send(event, "attributeDescriptorForKeyword:", kAEQuitReason)
+	if why == 0 {
+		return platform.QuitReasonUser
+	}
+	switch sendInt(why, "enumCodeValue") {
+	case kAELogOut, kAEReallyLogOut, kAERestart, kAEShutDown, kAEShowRestartDialog, kAEShowShutdownDialog:
+		return platform.QuitReasonSystemPowerOff
+	}
+	return platform.QuitReasonUser
+}
