#!/bin/sh
# Sun Ray — self-contained systemd installer for Debian / Ubuntu.
# Generated by scripts/make_systemd_installer.py. Do not edit by hand.
#
# Usage:
#   sudo ./sun-ray-systemd-debian-ubuntu-<variant>.sh
#   sudo ./sun-ray-systemd-debian-ubuntu-<variant>.sh --uninstall
#
# The three Linux binaries (amd64, arm64, armv7) are embedded below as
# gzipped base64. The installer detects the machine at run time and lays
# down only the matching one.

set -eu

VARIANT='__VARIANT__'
VERSION='__VERSION__'
B64_AMD64='__B64_AMD64__'
B64_ARM64='__B64_ARM64__'
B64_ARMV7='__B64_ARMV7__'

SERVICE='sun-ray'
BIN_PATH='/usr/local/bin/sun-ray'
UNIT_PATH='/etc/systemd/system/sun-ray.service'
CONF_DIR='/etc/sun-ray'
CONF_PATH="$CONF_DIR/sunray.json"
RUN_USER='sunray'

say() { printf '%s\n' "$*"; }
die() { printf '错误：%s\n' "$*" >&2; exit 1; }

tmpdir=
cleanup() { [ -n "$tmpdir" ] && rm -rf "$tmpdir"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<EOF
用法：$0 [选项]

  （无参数）   安装 Sun Ray $VARIANT 为 systemd 服务
  --uninstall  停止并禁用服务，删除二进制、单元、配置和用户
  -h, --help   显示本帮助

安装位置（Debian / Ubuntu）：
  二进制    $BIN_PATH
  服务单元  $UNIT_PATH
  配置      $CONF_PATH   （已存在则保留）
  运行用户  $RUN_USER      （系统用户，不可登录）

检测到的架构会自动选择内嵌的 amd64 / arm64 / armv7 二进制。
EOF
}

require_root() {
    [ "$(id -u)" -eq 0 ] || die "请用 root 运行：sudo $0"
}

check_systemd() {
    command -v systemctl >/dev/null 2>&1 ||
        die "找不到 systemctl：此脚本只适用于使用 systemd 的系统（Debian / Ubuntu）"
    if [ ! -d /run/systemd/system ]; then
        say "警告：systemd 似乎不是当前系统的 PID 1，启用服务可能会失败。"
    fi
}

detect_arch() {
    machine=$(uname -m)
    case "$machine" in
        x86_64|amd64)        printf '%s\n' amd64 ;;
        aarch64|arm64)       printf '%s\n' arm64 ;;
        armv7l|armv6l|armv5tel|armhf) printf '%s\n' armv7 ;;
        *) die "不支持的 CPU 架构：$machine（本脚本支持 amd64 / arm64 / armv7）" ;;
    esac
}

ask_yes() {
    # $1 = prompt. Anything but an explicit y/yes means no.
    printf '%s [y/N] ' "$1"
    answer=
    if ! read -r answer; then
        answer=
    fi
    case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

write_default_config() {
    [ -f "$CONF_PATH" ] && { say "保留现有配置：$CONF_PATH"; return; }
    cat > "$CONF_PATH" <<'JSON'
{
  "global": {
    "listenPort": "10808",
    "logLevel": "info",
    "routeCN": true,
    "domainStrategy": "asis",
    "dnsPreset": "system"
  },
  "servers": [
    {
      "id": "default-direct",
      "name": "Direct (freedom)",
      "protocol": "freedom",
      "network": "tcp",
      "security": "none"
    }
  ],
  "activeId": "default-direct"
}
JSON
    say "已写入默认配置（直连）：$CONF_PATH —— 请按需替换为自己的服务器。"
}

write_unit() {
    case "$VARIANT" in
        nogui) desc='Sun Ray (headless)' ;;
        webui) desc='Sun Ray (web interface, http://127.0.0.1:3785)' ;;
        *) die "未知的变体：$VARIANT" ;;
    esac
    cat > "$tmpdir/sun-ray.service" <<EOF
[Unit]
Description=$desc
Documentation=https://github.com/idealisan/sun-ray
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$RUN_USER
Group=$RUN_USER
ExecStart=$BIN_PATH -config $CONF_PATH
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=$CONF_DIR

[Install]
WantedBy=multi-user.target
EOF
}

do_install() {
    require_root
    check_systemd
    arch=$(detect_arch)

    say ""
    say "Sun Ray $VARIANT $VERSION —— systemd 安装"
    say "  架构：$arch"
    say "  二进制：$BIN_PATH"
    say "  服务单元：$UNIT_PATH"
    say "  配置：$CONF_PATH（已存在则保留）"
    say "  运行用户：$RUN_USER"
    say ""
    ask_yes "确认安装？" || die "已取消，未改动系统。"

    tmpdir=$(mktemp -d)
    case "$arch" in
        amd64) blob=$B64_AMD64 ;;
        arm64) blob=$B64_ARM64 ;;
        armv7) blob=$B64_ARMV7 ;;
    esac
    say "释放 $arch 二进制..."
    printf '%s' "$blob" | base64 -d | gzip -dc > "$tmpdir/sun-ray" ||
        die "释放二进制失败（下载的脚本可能已损坏）"
    chmod 0755 "$tmpdir/sun-ray"

    if ! id -u "$RUN_USER" >/dev/null 2>&1; then
        say "创建系统用户 $RUN_USER..."
        useradd --system --no-create-home --home-dir "$CONF_DIR" \
            --shell /usr/sbin/nologin "$RUN_USER" || die "无法创建用户 $RUN_USER"
    fi

    mkdir -p "$CONF_DIR"
    write_default_config
    chown -R "$RUN_USER:" "$CONF_DIR"
    chmod 0750 "$CONF_DIR"
    chmod 0640 "$CONF_PATH"

    say "安装二进制与服务单元..."
    install -m 0755 "$tmpdir/sun-ray" "$BIN_PATH"
    write_unit
    install -m 0644 "$tmpdir/sun-ray.service" "$UNIT_PATH"

    systemctl daemon-reload
    systemctl enable "$SERVICE"
    systemctl restart "$SERVICE"

    say ""
    say "安装完成。"
    say "  状态：systemctl status $SERVICE"
    say "  日志：journalctl -u $SERVICE -f"
    if [ "$VARIANT" = webui ]; then
        say "  管理页面：http://127.0.0.1:3785"
    fi
}

do_uninstall() {
    require_root

    say ""
    say "Sun Ray 卸载：将停止并禁用服务，删除"
    say "  $BIN_PATH"
    say "  $UNIT_PATH"
    say "  $CONF_DIR（配置文件将一并删除）"
    say "  系统用户 $RUN_USER"
    say ""
    ask_yes "确认卸载？" || die "已取消，未改动系统。"

    systemctl stop "$SERVICE" >/dev/null 2>&1 || true
    systemctl disable "$SERVICE" >/dev/null 2>&1 || true
    rm -f "$UNIT_PATH" "$BIN_PATH"
    rm -rf "$CONF_DIR"
    if id -u "$RUN_USER" >/dev/null 2>&1; then
        userdel "$RUN_USER" >/dev/null 2>&1 ||
            say "警告：无法删除用户 $RUN_USER，请手动检查。"
    fi
    systemctl daemon-reload || true
    say "卸载完成。"
}

case "${1:-}" in
    "")          do_install ;;
    --uninstall) do_uninstall ;;
    -h|--help)   usage ;;
    *)           usage >&2; die "未知参数：$1" ;;
esac
